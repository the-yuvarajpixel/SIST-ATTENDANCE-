# Use "mock" for instant sample data (live sign-in still available on the Sign-In screen)
# or "live" to default the Sign-In screen to live ERP + Moodle LMS authentication.
DATA_SOURCE=mock

# Moodle LMS base URL (must be public HTTPS). Defaults to Sathyabama's Moodle LMS.
LMS_BASE_URL=https://sathyabama.cognibot.in

# College ERP JSON gateway base URL (must be public HTTPS) for live attendance, timetable, and results.
ERP_BASE_URL=https://erp.sathyabama.ac.in

# Optional custom ERP endpoint paths (defaults shown):
# ERP_PROFILE_PATH=/api/student/profile
# ERP_ATTENDANCE_PATH=/api/student/attendance
# ERP_TIMETABLE_PATH=/api/student/timetable
# ERP_RESULTS_PATH=/api/student/results
# ERP_CAE_RESULTS_PATH=/erp/api/v1.0/CAEResult/studentCAEResult
# ERP_CAE_UPLOAD_PATH=/erp/api/v1.0/CAEResult/saveStudentCAEResult
# ERP_DEADLINES_PATH=/api/student/deadlines
# ERP_NOTIFICATIONS_PATH=/api/student/notifications

# Required in production; generate a random 32+ character secret.
SESSION_SECRET=replace-with-a-32-character-random-secret
PORT=3000
